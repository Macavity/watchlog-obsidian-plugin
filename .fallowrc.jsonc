{
	// fallow code-health config, see https://fallow.tools/docs.
	// `pnpm fallow:audit` gates changed files (new-only), `pnpm fallow:report` is the
	// whole-repo picture. Pinned to fallow 3.35.0 in package.json; when bumping, repeat
	// the duplication probe (copy a file, audit must fail with "exceeds threshold").
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

	"entry": ["src/main.ts"],

	"duplicates": {
		// Audit tiers duplication as warn by default, even when the change introduces
		// it. Any threshold > 0 turns introduced duplication into a fail verdict, while
		// inherited clones in touched files stay excluded by the new-only gate. 0.001 is
		// below the smallest reportable clone (5 lines of ~55k, about 0.009 %).
		"threshold": 0.001
	},

	// Obsidian calls these overrides itself; static analysis cannot see the call.
	"usedClassMembers": [
		{ "extends": "FuzzySuggestModal", "members": ["getItems", "getItemText", "onChooseItem"] },
		{ "extends": "PluginSettingTab", "members": ["display", "hide"] },
		{ "extends": "ItemView", "members": ["*"] },
		{ "extends": "Modal", "members": ["onOpen", "onClose"] }
	],

	// tsconfig `importHelpers: true` needs tslib at type-check time; nothing imports it.
	"ignoreDependencies": ["tslib"]
}
