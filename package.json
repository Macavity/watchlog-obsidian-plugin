{
	"name": "watchlog-sync-plugin",
	"version": "4.0.0",
	"description": "Track anime, movies, TV shows, books, manga and games as notes in your vault, synced across devices. Fork of WatchLog by BogdanS.",
	"main": "main.js",
	"type": "module",
	"packageManager": "pnpm@10.30.2",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run",
		"deploy": "node scripts/deploy.mjs",
		"fallow:audit": "fallow audit --no-cache",
		"fallow:report": "fallow --score --no-cache"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "^20.19.43",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fallow": "3.35.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.72.0",
		"vitest": "^3.2.7",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"fuse.js": "^7.3.0",
		"obsidian": "latest"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"peerDependencyRules": {
			"allowedVersions": {
				"obsidian": "*"
			}
		}
	}
}
